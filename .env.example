# ============================================================
# SUPABASE  (Project Settings > API)
# ============================================================
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# The public publishable key. NEVER put the service_role/secret key in a mobile app.
EXPO_PUBLIC_SUPABASE_KEY=TU_PUBLISHABLE_KEY

# ============================================================
# DEEP LINKING / OAUTH
# ============================================================
# Scheme configured in app.json. The app builds redirect URLs from it:
#   native: crud://auth-callback
#   web:    <origin>/auth-callback
# Add these URLs to Supabase > Authentication > URL Configuration:
#   - Redirect URLs: crud://auth-callback?flow=oauth
#                    http://localhost:8081/auth-callback?flow=oauth
#   - Site URL: http://localhost:8081
EXPO_PUBLIC_APP_SCHEME=crud

# Google OAuth Client ID is configured ONLY in:
# Supabase Dashboard > Authentication > Providers > Google
# Google Cloud Console must use this Authorized redirect URI:
#   https://shduhgagxavqsheeurbl.supabase.co/auth/v1/callback
# Never place the Google Client Secret in this app.
